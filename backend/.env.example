# ---------------------------------------------------------------------------
# MedCore HMS API - environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Node environment: development | production | test
NODE_ENV=development

# Port the API listens on
PORT=4000

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Any Postgres works: Supabase, Neon, RDS, or your own server.
#
# Supabase -> Project Settings -> Database -> Connection string -> "URI"
#   Session pooler (port 5432) is the one to use with this API. It supports the
#   prepared statements and transactions that migrations rely on.
#   Transaction pooler (port 6543) does not: schema changes and multi-statement
#   transactions can fail. Use it only if you know you need it.
#   Pooler-only parameters (`pgbouncer`, `connection_limit`) are stripped
#   automatically, so the string can be pasted as Supabase shows it.
#
# Local PostgreSQL example:
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable"

# Set to `true` to boot an embedded PGlite (Postgres compiled to WASM) database
# on first run. Meant for local development / demos only - never for production.
# When enabled, DATABASE_URL above is ignored.
DEV_DB=true

# Port for the embedded database. It is internal - nothing outside the API
# connects to it - so leaving it commented out lets a free port be chosen,
# which avoids clashes with a local Postgres or with ports Windows reserves
# (Hyper-V and WinNAT reserve ranges). Uncomment only if you need a fixed port.
# DEV_DB_PORT=5432

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# How long a rotated refresh token may be replayed while still being accepted.
# Browsers fire parallel requests, so a second tab refreshing at the same moment
# is normal; this window lets it through instead of logging the user out.
REFRESH_REUSE_GRACE_SECONDS=120

# Initial administrator created by `npm run db:seed` (no demo users are created)
ADMIN_NAME="System Administrator"
ADMIN_EMAIL="admin@yourclinic.co.ke"
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Clinic identity (used for the initial settings row only - edit in the app)
# ---------------------------------------------------------------------------
CLINIC_NAME="Your Clinic"
CLINIC_LOCATION="Nairobi, Kenya"
CLINIC_CURRENCY=KES

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# Comma separated list of allowed browser origins. Leave empty to allow all
# (fine for local dev). In production list your real domain(s).
CORS_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the API (1 = Render/Railway/Nginx).
# Required for rate limiting to see real client IPs.
TRUST_PROXY=0
