# ---------------------------------------------------------------------------
# Configuration used by automated tests (local runs and CI).
#
# These are throwaway values for an ephemeral, embedded database. They are not
# secrets: the database lives in a temp directory that is deleted afterwards,
# and none of these credentials exist anywhere else.
#
# The API reads .env automatically, but NOT this file. Load it explicitly:
#
#   set -a && . backend/.env.test && set +a && npm run test:e2e
#
# or let the test:e2e script do it for you (see package.json).
# ---------------------------------------------------------------------------

NODE_ENV=test

# Embedded Postgres, throwaway data directory
DEV_DB=true
DEV_DB_PORT=5433

# Signing key for the duration of the run
JWT_SECRET=test-only-secret-value-not-used-in-production-000000

# Administrator created by the seed step
ADMIN_EMAIL=admin@medcore.ke
ADMIN_PASSWORD=Test-Admin-Password-2026
CLINIC_NAME=Test Clinic

# The suite drives many logins and bookings in a few seconds, so the
# production rate limits would trip and look like application failures.
LOGIN_RATE_LIMIT=1000
LOGIN_RATE_WINDOW_MINUTES=15
BOOKING_RATE_LIMIT=2000
